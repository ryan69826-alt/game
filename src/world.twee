:: PassageHeader [nobr]
<<if tags().includes("world")>>
<<run setup.character.ensure()>>
<<include "WorldSidebar">>
<</if>>

:: WorldSidebar [nobr]
<aside class="world-sidebar" aria-label="Character sidebar">
<figure class="world-map-panel">
<div class="map-heading"><span>WORLD MAP</span><span id="world-map-count"></span></div>
<div class="map-viewport"><canvas id="world-map" width="300" height="300" role="img" aria-label="World map showing the current area"></canvas></div>
<<button "Expand world map">><<run setup.worldAtlas.open()>><</button>>
<figcaption><span class="location-dot" aria-hidden="true"></span><span id="world-map-location"></span></figcaption>
</figure>
<div class="sidebar-character"><<include "CharacterArtwork">></div>
<p id="preview-status" class="preview-status" role="status" aria-live="polite"></p>
<div class="sidebar-clock" aria-label="Game date and time"><time id="player-date"></time><time id="player-time"></time></div>
<div class="sidebar-vitals" aria-label="Money and health">
<div><span>Money</span><output id="player-money"></output></div>
<div><label for="player-health-bar">Health</label><output id="player-health"></output></div>
<progress id="player-health-bar" aria-label="Health" max="100" value="100"></progress>
<div><label for="player-endurance-bar">Endurance used</label><output id="player-endurance"></output></div>
<progress id="player-endurance-bar" aria-label="Endurance used" max="25" value="0"></progress>
<div><span>Tiredness</span><output id="player-tiredness"></output></div>
<div><span>Fatigue</span><output id="player-fatigue"></output></div>
</div>
<nav class="sidebar-nav" aria-label="Game pages">
<<link "Character">><<run setup.worldWindows.open("Character")>><</link>>
<<link "Inventory">><<run setup.inventoryUI.open()>><</link>>
<<link "Stats">><<run setup.worldWindows.open("Stats")>><</link>>
</nav>
<div class="sidebar-utilities">
<<link "Saves">><<run UI.saves()>><</link>>
[[Main menu|MainMenu]]
</div>
</aside>

:: Apartments [nobr world]
<<set $worldStarted = true>>
<<run setup.worldMovement.ensure()>>
<main class="world-content location-layout" aria-labelledby="location-title">
<div class="location-story">

<section class="movement-panel" aria-labelledby="movement-title">
<div class="movement-info">
<div class="movement-heading"><h2 id="movement-title">Move around</h2><div class="movement-actions"><button id="sprint-button" type="button" aria-pressed="false">Sprint [Shift]</button><button id="actions-button" type="button">Actions [T]</button><button id="interact-button" type="button" disabled>Interact [E]</button></div></div>
<p id="movement-help">Hold arrows, WASD, or a button. Walk: 5 seconds per square. Sprint: 2 seconds. Hold Shift or toggle Sprint.</p>
<p id="position-description"></p>
<div class="movement-readout"><span id="movement-position"></span></div>
<p id="interaction-hint" class="interaction-hint"></p>
</div>
<div class="movement-pad" role="group" aria-label="Movement controls">
<button type="button" data-move="north" aria-label="Move north">↑</button>
<button type="button" data-move="west" aria-label="Move west">←</button>
<span aria-hidden="true">◈</span>
<button type="button" data-move="east" aria-label="Move east">→</button>
<button type="button" data-move="south" aria-label="Move south">↓</button>
</div>
<p id="movement-status" role="status" aria-live="polite"></p>
</section>
<header class="world-heading"><p id="location-eyebrow" class="eyebrow">URBAN AREA · RESIDENTIAL</p><h1 id="location-title">Apartments</h1><p id="location-subtitle" class="world-subtitle">A small corner of the city.</p></header>
<section class="location-description" aria-label="Location description"><p id="location-description"></p><p id="housing-summary" class="world-note"></p></section>
<section class="room-sounds" aria-labelledby="sounds-title"><h2 id="sounds-title">Sounds</h2><p id="room-sounds"></p></section>


</div>
<div class="map-stack">
<figure class="district-map">
<div class="map-heading"><span>LOCAL MAP</span><span id="local-map-title">APARTMENTS · 50 × 50</span></div>
<div class="map-viewport"><canvas id="local-map" width="400" height="560" role="img" tabindex="0" aria-label="Apartments area map" aria-describedby="movement-help"></canvas></div>
<figcaption><span class="location-dot" aria-hidden="true"></span> You <span id="map-camera-note">Scrolls as you move</span></figcaption>
<div id="local-map-legend" class="map-legend"><span><i class="legend-door"></i>Entrance</span><span><i class="legend-park"></i>Park</span><span><i class="legend-road"></i>Road</span></div>
</figure>

</div>
</main>

:: CharacterSheet [nobr]
<div class="character-window-content">
<p class="world-note">Identity, appearance, and starting traits.</p>
<section class="world-panel" aria-labelledby="identity-title"><h2 id="identity-title">Identity & appearance</h2><dl id="character-details" class="character-details"></dl></section>
<section class="world-panel" aria-labelledby="traits-title"><h2 id="traits-title">Starting traits</h2><ul id="character-traits" class="trait-tags"></ul></section>
</div>

:: StatsSheet [nobr]
<div class="character-window-content">
<section class="world-panel" aria-labelledby="vitals-title"><h2 id="vitals-title">Vitals & money</h2><dl id="player-stats" class="character-details"></dl></section>
<section class="world-panel" aria-labelledby="skills-title"><h2 id="skills-title">Skills</h2><p class="world-note">Levels range from 0 (untrained) to 10. XP shown is progress toward the next level.</p><div id="world-skills" class="world-skills"></div></section>
<p class="world-note">Additional character stats and trait effects have not been defined yet.</p>
</div>

:: Character [nobr]
<<goto "Apartments">>

:: Stats [nobr]
<<goto "Apartments">>
