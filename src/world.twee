:: PassageHeader [nobr]
<<if tags().includes("world")>>
<<run setup.character.ensure()>>
<<include "WorldSidebar">>
<</if>>

:: WorldSidebar [nobr]
<aside class="world-sidebar" aria-label="Character sidebar">
<a class="sidebar-brand" data-passage="Apartments" aria-label="Neon Meridian — Apartments">◈ <span>NEON MERIDIAN</span></a>
<p class="sidebar-eyebrow">YOUR CHARACTER</p>
<div class="sidebar-character"><<include "CharacterArtwork">></div>
<p class="sidebar-identity"><span data-character-summary></span><span class="sidebar-age">Age 26</span></p>
<p id="preview-status" class="preview-status" role="status" aria-live="polite"></p>
<nav class="sidebar-nav" aria-label="Game pages">
[[Apartments|Apartments]]
<<link "Character">><<run setup.worldWindows.open("Character")>><</link>>
<<link "Stats">><<run setup.worldWindows.open("Stats")>><</link>>
</nav>
<div class="sidebar-utilities">
<<link "Saves">><<run UI.saves()>><</link>>
[[Main menu|MainMenu]]
</div>
</aside>

:: Apartments [nobr world]
<<set $worldStarted = true>>
<<run setup.worldMovement.ensure()>>
<main class="world-content location-layout" aria-labelledby="location-title">
<div class="location-story">
<header class="world-heading"><p class="eyebrow">URBAN AREA · RESIDENTIAL</p><h1 id="location-title">Apartments</h1><p class="world-subtitle">A small corner of the city.</p></header>
<section class="location-description" aria-label="Location description"><p>Four apartment buildings face a small central park. Paths link their entrances, with a parking lot to the southwest and two roads meeting along the southern edge.</p><p id="position-description"></p></section>
<section class="movement-panel" aria-labelledby="movement-title">
<h2 id="movement-title">Move around</h2>
<p id="movement-help">Move one square per turn with arrow keys, WASD, the buttons, or an adjacent square on the map.</p>
<div class="movement-readout"><span id="movement-position"></span><span>Turn <output id="movement-turn">0</output></span></div>
<div class="movement-pad" role="group" aria-label="Movement controls">
<button type="button" data-move="north" aria-label="Move north">↑</button>
<button type="button" data-move="west" aria-label="Move west">←</button>
<span aria-hidden="true">◈</span>
<button type="button" data-move="east" aria-label="Move east">→</button>
<button type="button" data-move="south" aria-label="Move south">↓</button>
</div>
<p id="movement-status" role="status" aria-live="polite"></p>
</section>
<div class="location-footer"><span class="location-dot" aria-hidden="true"></span> Current location <strong>Apartments</strong></div>
</div>
<div class="map-stack">
<figure class="district-map">
<div class="map-heading"><span>LOCAL MAP</span><span>APARTMENTS · 50 × 50</span></div>
<canvas id="local-map" width="400" height="560" role="img" tabindex="0" aria-label="Apartments area map" aria-describedby="movement-help"></canvas>
<figcaption><span class="location-dot" aria-hidden="true"></span> You <span>Scrolls as you move</span></figcaption>
<div class="map-legend"><span><i class="legend-door"></i>Entrance</span><span><i class="legend-park"></i>Park</span><span><i class="legend-road"></i>Road</span></div>
</figure>
<figure class="world-map-panel">
<div class="map-heading"><span>WORLD MAP</span><span>1 AREA</span></div>
<canvas id="world-map" width="300" height="300" role="img" aria-label="World map showing Apartments and your position"></canvas>
<figcaption><span class="location-dot" aria-hidden="true"></span> Apartments <span>Current area</span></figcaption>
</figure>
</div>
</main>

:: CharacterSheet [nobr]
<div class="character-window-content">
<p class="world-note">Identity, appearance, and starting traits.</p>
<section class="world-panel" aria-labelledby="identity-title"><h2 id="identity-title">Identity & appearance</h2><dl id="character-details" class="character-details"></dl></section>
<section class="world-panel" aria-labelledby="traits-title"><h2 id="traits-title">Starting traits</h2><ul id="character-traits" class="trait-tags"></ul></section>
</div>

:: StatsSheet [nobr]
<div class="character-window-content">
<section class="world-panel" aria-labelledby="skills-title"><h2 id="skills-title">Skills</h2><p class="world-note">Levels range from 0 (untrained) to 10. XP shown is progress toward the next level.</p><div id="world-skills" class="world-skills"></div></section>
<p class="world-note">Additional character stats and trait effects have not been defined yet.</p>
</div>

:: Character [nobr]
<<goto "Apartments">>

:: Stats [nobr]
<<goto "Apartments">>
