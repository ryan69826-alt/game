:: StoryTitle
Neon Meridian

:: StoryData
{
  "ifid": "F14A62EB-1B82-455E-A371-8AA2DC8B73D5",
  "format": "SugarCube",
  "format-version": "2.37.3",
  "start": "MainMenu",
  "zoom": 1
}

:: MainMenu [nobr]
<main class="menu-screen">
<div class="brand-mark" aria-hidden="true">◈</div>
<p class="eyebrow">A BROWSER RPG</p>
<h1>Neon<br><span>Meridian</span></h1>
<div class="menu-divider"></div>
<nav class="main-menu" aria-label="Main menu">
<<if $worldStarted>>[[Continue|Apartments]]<<else>>[[Character Creation|CharacterCreation]]<</if>>
<<link "Options">><<run UI.settings()>><</link>>
<<link "Import/Export Saves">><<run UI.saves()>><</link>>
</nav>
<p class="menu-footer">EARLY DEVELOPMENT <span>·</span> INTERFACE PREVIEW</p>
</main>

:: CharacterCreation [nobr creation]
<<if $worldStarted>><<goto "Apartments">><<else>>
<<run setup.character.ensure()>>
<main class="menu-screen creation-screen">
<div class="creation-layout">
<section class="creation-intro" aria-labelledby="creation-title">
<div class="brand-mark" aria-hidden="true">◈</div>
<p class="eyebrow">ADULT CHARACTER · AGE 26</p>
<h1 id="creation-title">Character<br><span>Creation</span></h1>
<p class="menu-description">Every story starts with someone.</p>
<div id="character-controls" aria-label="Character customization"></div>
<nav class="main-menu character-actions" aria-label="Character creation navigation">[[Start at Apartments|Apartments]][[Save & return to menu|MainMenu]]</nav>
</section>
<figure class="character-preview">
<div class="preview-heading"><span class="eyebrow">LIVE PREVIEW</span><span class="preview-badge">ADULT · 26</span></div>
<<include "CharacterArtwork">>
<figcaption><span id="build-description"></span><br><span id="appearance-description"></span></figcaption>
<p class="preview-note">Fixed adult base models use separate clothing layers. Genitals are saved independently of appearance.</p>
<p id="preview-status" class="preview-status" role="status" aria-live="polite"></p>
</figure>
</div>
</main>

<</if>>

:: Apartment [nobr]
<<goto "Apartments">>

:: Street [nobr]
<<goto "MainMenu">>

:: Cafe [nobr]
<<goto "MainMenu">>

:: CharacterArtwork [nobr]
<div class="sprite-stage"><canvas id="character-canvas" width="288" height="416" role="img" aria-label="Adult character appearance preview"></canvas></div>
<div hidden aria-hidden="true">
<canvas id="backpack-layer" width="288" height="416"></canvas>
<canvas id="body-layer" width="288" height="416"></canvas>
<canvas id="clothing-layer" width="288" height="416"></canvas>
<canvas id="head-layer" width="288" height="416"></canvas>
<canvas id="hair-layer" width="288" height="416"></canvas>
<img class="character-source" id="female-base-layers" src="asset:characters/female-base-layers.png" alt="">
<img class="character-source" id="paper-dolls" src="asset:characters/paper-dolls.png" alt="">
<img class="character-source" id="head-reference" src="asset:characters/body-atlas.png" alt="">
<img class="character-source" id="long-hair-atlas" src="asset:characters/hair-layers.png" alt="">
<img class="character-source" id="hair-atlas" src="asset:characters/hair-atlas.png" alt="">
</div>
